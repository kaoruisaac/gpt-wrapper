<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: the only resource GPT Wrapper needs is audio input,
	     for ChatGPT / Claude web dictation (push-to-talk). No camera, no
	     Accessibility, no Input Monitoring, no App Sandbox exceptions. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
