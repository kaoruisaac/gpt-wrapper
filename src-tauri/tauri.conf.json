{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT Wrapper",
  "version": "0.0.4",
  "identifier": "cc.pedelec.gptwrapper",
  "build": {
    "beforeDevCommand": "npm run frontend:build",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": ["resources/ui-success-chime.wav", "resources/ui-success-chime.LICENSE.txt"],
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
