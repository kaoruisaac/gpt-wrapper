{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT Wrapper",
  "version": "0.0.3",
  "identifier": "cc.pedelec.gptwrapper",
  "build": {
    "beforeDevCommand": "npm run frontend:build",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
